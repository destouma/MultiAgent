<idea-plugin>
    <id>com.multiagent.intellij</id>
    <name>MultiAgent</name>
    <vendor>MultiAgent</vendor>

    <description><![CDATA[
        Multi-agent chat over a local LLM server, in a JetBrains IDE tool window.
        Connects to Lemonade, any OpenAI-compatible server, or a native Ollama server.
        The core (LLM clients, workspace tools, orchestrator, persistence) is a deliberate
        fork of the desktop-java client - the two projects are kept independent.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="MultiAgent"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="com.multiagent.intellij.ui.MultiAgentToolWindowFactory"/>
        <applicationConfigurable parentId="tools"
                                  instance="com.multiagent.intellij.ui.MultiAgentConfigurable"
                                  id="com.multiagent.intellij.ui.MultiAgentConfigurable"
                                  displayName="MultiAgent"/>
        <statusBarWidgetFactory id="MultiAgent.StatusBar"
                                 implementation="com.multiagent.intellij.ui.MultiAgentStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <action id="MultiAgent.SpikeStorage"
                class="com.multiagent.intellij.ui.SpikeStorageAction"
                text="MultiAgent: Storage Spike"
                description="Phase-0 spike: open ConversationStore under the plugin config dir and round-trip a row.">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="MultiAgent.AddSelection"
                class="com.multiagent.intellij.ui.AddSelectionToChatAction"
                text="MultiAgent: Add Selection to Chat"
                description="Drop the current editor selection into the MultiAgent composer.">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="MultiAgent.ExplainSelection"
                class="com.multiagent.intellij.ui.ExplainSelectionAction"
                text="MultiAgent: Explain Selection"
                description="Send the current editor selection to MultiAgent with an explain-this prompt.">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
