node_modules/
dist/
dist-electron/
release/
*.vsix
# Copied from the repo-root personas/ by vscode-extension/esbuild.js at build
# time; anchored so it doesn't match the real repo-root personas/ directory.
/vscode-extension/personas/
*.log
.DS_Store
Thumbs.db
.env
.env.*
*.db
*.db-*
*.tgz
# Maven build output (desktop-java/) - regenerated by mvn compile/test/javafx:run
desktop-java/target/
# SBOM/Grype/CodeQL scan output (SARIF, SBOM JSON, the raw CodeQL extraction
# database) - regenerated on demand, not meant to be version-controlled.
release-verify/security-scan/
# Unpacked installer contents a release-verify run leaves behind.
release-verify/*-unpacked*/
release-verify/*.tmp/
# Local WiX Toolset extension cache - lands here if `wix extension add` is ever
# run without -g/--global from the repo root; machine-local tooling state.
.wix/
