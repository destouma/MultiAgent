<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.multiagent</groupId>
  <artifactId>desktop-java</artifactId>
  <version>1.3.1</version>
  <packaging>jar</packaging>

  <name>MultiAgent Desktop (Java)</name>
  <description>Java/JavaFX desktop client for MultiAgent - the actively developed client, desktop/ (Electron) is deprecated</description>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.4</javafx.version>
    <junit.version>5.11.3</junit.version>
    <!-- 2.18.9 clears the jackson-core / jackson-databind advisories flagged by the
         release-verify SBOM scan (GHSA-r7wm-3cxj-wff9, GHSA-rmj7-2vxq-3g9f,
         GHSA-j3rv-43j4-c7qm and the related medium ones); patch-only bump within 2.18.x. -->
    <jackson.version>2.18.9</jackson.version>
    <!-- mvn javafx:run sets up the module path itself, so it launches App directly. A
         packaged (jpackage) run is a plain classpath app and needs Launcher instead - see
         Launcher.java's javadoc. -->
    <main.class>com.multiagent.desktop.App</main.class>
    <packaged.main.class>com.multiagent.desktop.Launcher</packaged.main.class>
    <!-- OpenJFX native-bearing classifier. Defaults to Windows; the os-activated
         profiles below switch it to mac / mac-aarch64 / linux, and
         `-Djavafx.classifier=…` overrides everything. -->
    <javafx.classifier>win</javafx.classifier>
  </properties>

  <dependencies>
    <!-- JavaFX. The ${javafx.classifier} is set explicitly on all four modules (base/graphics
         included, not just the two this app imports directly - Maven doesn't reliably
         propagate a classifier through transitive resolution). It defaults to "win" and is
         switched to mac / mac-aarch64 / linux by the os-activated <profiles> at the bottom of
         this POM (so `mvn package` picks the right native jars on each CI runner). The
         classifier-less artifact has no native graphics/glass libraries at all, so
         mvn javafx:run's dev loop happens to work only because the javafx-maven-plugin
         resolves the platform-specific jars itself, separately from these plain
         <dependencies>; jpackage's own "input directory" option needs the real
         native-bearing jars sitting right here to package correctly. Each -win module's own
         POM declares its next-lower module WITHOUT a classifier (a known OpenJFX/Maven
         quirk), so each level here excludes that classifier-less transitive copy - without
         it, both variants of the same module land in target/jpackage-input/ side by side. -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.classifier}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.classifier}</classifier>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-base</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.classifier}</classifier>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-graphics</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.classifier}</classifier>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Persistence -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.47.1.0</version>
    </dependency>

    <!-- JSON. jackson-core is pinned explicitly (not just pulled in transitively) so the
         SBOM records the patched version unambiguously. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <!-- Rich text / code blocks -->
    <dependency>
      <groupId>org.fxmisc.richtext</groupId>
      <artifactId>richtextfx</artifactId>
      <version>0.11.3</version>
    </dependency>

    <!-- Checkpoint diff/revert (Phase 5) - unified line diffs, in place of the TS app's "diff" npm package -->
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
      <version>4.12</version>
    </dependency>

    <!-- Tests -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>multiagent-desktop</finalName>
    <resources>
      <!-- App's own resources (FXML, CSS) -->
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- Reuse the repo-root personas/ as the single source of truth,
           mirroring personaRegistry.ts's dev-path resolution. -->
      <resource>
        <directory>${project.basedir}/../personas</directory>
        <targetPath>personas</targetPath>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <!-- Packaging (mvn package): assembles target/jpackage-input/ - this app's own jar
           plus every runtime dependency jar (including the win-classified JavaFX natives)
           flat in one directory, which is exactly the shape jpackage's non-modular
           "input directory" mode expects: it wires up the full classpath from whatever jars it finds there,
           no fat-jar/shading and no module-info.java needed. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
          <archive>
            <manifest>
              <mainClass>${packaged.main.class}</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.8.1</version>
        <executions>
          <execution>
            <id>copy-runtime-deps-for-jpackage</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- PersonaRegistry resolves personas/ next to the jar's own on-disk location for a
           packaged (non-dev) run - not classpath resources inside the jar, which the
           <resources> block above already bundles there but which a packaged app never
           actually reads - so a real personas/ directory needs to sit as a sibling of the
           jar in jpackage-input/ too. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-personas-for-jpackage</id>
            <phase>package</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/jpackage-input/personas</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../personas</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- `mvn javafx:run` dev loop -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>${main.class}</mainClass>
          <options>
            <!-- Silences the JEP 472 "restricted method" warnings from JavaFX's and
                 sqlite-jdbc's native library loading (System.load) on JDK 24+. This flag
                 itself has been stable since JDK 17, so it's safe on our JDK 21 baseline
                 too, unlike the newer sun.misc.Unsafe suppression flag (JDK 23+ only),
                 which is why that one isn't added here: it would make the app refuse to
                 start at all on JDK 21/22 with "Unrecognized VM option". -->
            <option>--enable-native-access=javafx.graphics,ALL-UNNAMED</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Selects the OpenJFX native classifier for the build host, so `mvn package` on a CI
       runner assembles target/jpackage-input/ with the jars that OS's jpackage needs. Only
       the property changes; the jpackage invocation itself stays a per-OS shell step (see
       .github/workflows/desktop-java.yml and ARCHITECTURE.md §8). Override with
       `-Djavafx.classifier=…` on the command line. -->
  <profiles>
    <profile>
      <id>jfx-windows</id>
      <activation><os><family>windows</family></os></activation>
      <properties><javafx.classifier>win</javafx.classifier></properties>
    </profile>
    <profile>
      <id>jfx-linux</id>
      <activation><os><name>linux</name></os></activation>
      <properties><javafx.classifier>linux</javafx.classifier></properties>
    </profile>
    <profile>
      <id>jfx-mac-intel</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties><javafx.classifier>mac</javafx.classifier></properties>
    </profile>
    <profile>
      <id>jfx-mac-arm</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties><javafx.classifier>mac-aarch64</javafx.classifier></properties>
    </profile>
  </profiles>
</project>
