{
  "name": "multiagent-vscode",
  "displayName": "MultiAgent",
  "description": "Multi-agent chat over a local LLM server",
  "version": "0.1.0",
  "publisher": "multiagent-local",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/destouma/MultiAgent.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "multiagent",
          "title": "MultiAgent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "multiagent": [
        {
          "id": "multiagent.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "multiagent.switchServer",
        "title": "MultiAgent: Switch Server",
        "icon": "$(server-environment)"
      },
      {
        "command": "multiagent.toggleWorkspaceTools",
        "title": "MultiAgent: Toggle Workspace Tools",
        "icon": "$(folder)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "multiagent.switchServer",
          "when": "view == multiagent.chat",
          "group": "navigation"
        },
        {
          "command": "multiagent.toggleWorkspaceTools",
          "when": "view == multiagent.chat",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "MultiAgent",
      "properties": {
        "multiagent.providerType": {
          "type": "string",
          "enum": [
            "lemonade",
            "openai",
            "ollama"
          ],
          "enumDescriptions": [
            "Lemonade Server (adds real load-status reporting and explicit model preloading)",
            "Any other OpenAI-compatible server (NoLlama, LM Studio, vLLM, real OpenAI, ...)",
            "Native Ollama server"
          ],
          "default": "lemonade",
          "description": "Which API protocol to speak to the local server."
        },
        "multiagent.baseUrl": {
          "type": "string",
          "default": "http://localhost:13305/api/v1",
          "description": "Server API base URL (default is Lemonade's; use http://localhost:11434 for Ollama)."
        },
        "multiagent.apiKey": {
          "type": "string",
          "default": "local-llm",
          "description": "API key sent to the server (required by the OpenAI client; unused by most local servers)."
        },
        "multiagent.model": {
          "type": "string",
          "default": "",
          "description": "Chat model id loaded on the local server."
        },
        "multiagent.maxHistory": {
          "type": "number",
          "default": 40,
          "description": "Maximum number of past messages sent as context."
        },
        "multiagent.servers": {
          "type": "array",
          "default": [],
          "description": "Saved server connections. Use the \"MultiAgent: Switch Server\" command (server icon in the Chat view title bar) to add or switch between them, or edit this list directly.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "providerType",
              "baseUrl",
              "apiKey",
              "maxHistory"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "providerType": {
                "type": "string",
                "enum": [
                  "lemonade",
                  "openai",
                  "ollama"
                ]
              },
              "baseUrl": {
                "type": "string"
              },
              "apiKey": {
                "type": "string"
              },
              "maxHistory": {
                "type": "number"
              }
            }
          }
        },
        "multiagent.activeServerId": {
          "type": "string",
          "default": "",
          "description": "Id of the entry in multiagent.servers currently copied into providerType/baseUrl/apiKey/maxHistory. Set via the \"MultiAgent: Switch Server\" command."
        },
        "multiagent.enableWorkspaceTools": {
          "type": "boolean",
          "default": false,
          "description": "Let the assistant read and write files in the first open workspace folder (list_dir, read_file, write_file, delete_file). Toggle via the folder icon in the Chat view title bar."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vscode:prepublish": "node esbuild.js",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "openai": "^5.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.3"
  }
}
